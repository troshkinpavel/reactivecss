# Dependencies
node_modules/

# Build output: `npm run build` regenerates each dist/, and the npm packages are packed from them.
# Anchored, so tests/dist/ (the distribution tests' sources) stays tracked.
/dist/
/packages/mcp/dist/

# Test and benchmark output
test-results/
playwright-report/
coverage/
**/trace.zip
*.har
benchmarks/audit/results/**/*.log

# Internal experiments and the Visual Lab (not part of the public release)
/experiments/

# Website build output and caches (site/.gitignore covers the same paths for the site on its own)
site/dist/
**/.astro/
site/storybook-static/
site/test-results/
site/playwright-report/
# Regenerated by `npm run visual-review` (about 49 MB of PNG captures); the README there stays.
/site/docs/visual-review/**/*.png
# Original Claude Design exports (HTML, scripts, reference captures): local design sources only.
# The site's implementation is site/src/; nothing in the build reads this folder.
/site/design-source/
# Local Control Center (admin server and UI, its tests and config): a local tool, never part of the
# public site. The site only reads site/config/*.json, which stays tracked.
/site/admin/
/site/tests/admin/
/site/tests/unit/admin-*.test.ts
/site/playwright.admin.config.ts
/site/docs/admin-control-center.md
/site/docs/admin-release-workflow-validation.md
# Release operator notes: npm account details, kept local.
/docs/release-0.9.0-npm.md
# Launch marketing research and unpublished drafts: private, never committed.
/marketing/

# Secrets and local configuration
.env
.env.*
!.env.example
*.pem
*.key
.npmrc
# Cloudflare Wrangler: local state, logs and dev secrets
.wrangler/
.dev.vars
.dev.vars.*
.claude/

# Packed tarballs (`npm pack`)
*.tgz

# OS and editor files
.DS_Store
.idea/
.vscode/
*.log
.cache/
.tmp/
