---
interface Props { level: 2 | 3; id?: string; 'data-step'?: string }
const { level, id, 'data-step': step } = Astro.props;
const Tag = level === 2 ? 'h2' : 'h3';
---
<Tag
  id={id}
  data-step={step}
  class:list={[
    'max-w-(--container-prose) scroll-mt-[110px] font-semibold text-balance',
    level === 2 ? 'mt-14 mb-3.5 flex items-baseline gap-3.5 text-h2 leading-[1.2] tracking-h2' : 'mt-9 mb-2.5 text-[19px] leading-[1.3] tracking-[-0.01em]',
  ]}
><slot /></Tag>
