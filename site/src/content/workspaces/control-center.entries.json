  {
    "id": "d-theme",
    "kind": "Declaration",
    "fn": "state",
    "expr": "--theme: state(\"light\")",
    "own": "theme",
    "what": "Declares the color mode on the form: light, dark or system. It lives in memory and resets on reload; the theme radios are what gets submitted.",
    "aff": [
      "app",
      "themeSeg"
    ],
    "re": "--theme: state"
  },
  {
    "id": "d-accent",
