    "expr": "--theme: set(event(value))",
    "w": "theme",
    "trig": "change on input[name=theme]",
    "what": "When a theme radio changes, copies its value into --theme. The radios keep their native group, keyboard and form behavior.",
    "aff": [
      "themeSeg",
      "app"
    ],
    "re": "\\.theme input:on\\(change\\)"
  },
