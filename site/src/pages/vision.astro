---
// Vision v2 (design-source/Vision v2.dc.html): why Reactive CSS exists, not what it does. Live
// demos, comparisons, measurements and the bundle builder live on their own pages and are linked.
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SearchDialog } from '~/components/navigation/SearchDialog';
import { SiteFooter } from '~/components/navigation/SiteFooter';
import { SiteHeader, SiteMenu } from '~/components/navigation/SiteHeader';
import { SectionKicker } from '~/components/ui/SectionKicker';
import { buttonClass } from '~/components/ui/Button';
import { EvolutionSteps, ExperimentDemo } from '~/components/vision/VisionV2';
import { FOOTER_GROUPS, HOME_LINKS, SUGGESTED } from '~/lib/content/site';
import { INSTALL_TAG } from '~/lib/content/home';
import { LIBRARY_VERSION } from '~/lib/content/reference';
import { DISTRIBUTION, repositoryUrl } from '~/lib/config';

const links = HOME_LINKS.map((l) => ({ ...l, current: l.href === '/vision/' }));
const container = 'mx-auto max-w-(--container-marketing) px-(--gutter)';
const h2 = 'm-0 text-[clamp(36px,6vw,88px)] leading-[0.95] font-semibold tracking-[-0.045em] text-balance';
const section = 'scroll-mt-(--height-header) border-t border-line';
const PRINCIPLES = [
  ['Native first.', 'Reactive CSS does not replace selectors, calculations, form controls, animations or browser APIs. Where they already work, they are the answer.'],
  ['Explore what’s missing.', 'State, events and small interactions still usually need JavaScript glue. That gap is the part worth experimenting with.'],
  ['Make it usable today.', 'No compiler and no framework. A stylesheet and a small runtime that works in ordinary browsers, without waiting for new standards.'],
];
const QUESTIONS = [
  'How much local interface behavior can be expressed declaratively?',
  'Where does native CSS already provide the better solution?',
  'Which interactions still need JavaScript?',
  'What would make a declarative approach genuinely easier to understand?',
];
---
<BaseLayout title="Vision" description="Why Reactive CSS exists: CSS keeps gaining logic, native features come first, and state and events are the open question. An independent experiment, not a web standard.">
  <SiteHeader variant="home" links={links} menuTarget="site-menu" />
  <SiteMenu id="site-menu" links={links} />
  <main data-pagefind-body data-pagefind-meta="section:Vision">
    <section id="question" aria-labelledby="vision-title" class={`${container} pt-[clamp(56px,10vw,144px)] pb-[clamp(64px,9vw,128px)]`}>
      <div class="mb-[clamp(28px,4vw,56px)] flex flex-wrap justify-between gap-x-4 gap-y-2 font-mono text-meta text-mute">
        <SectionKicker comment n="01" label="The question" />
        <span class="italic">An independent experiment in declarative web interactions.</span>
      </div>
      <h1 id="vision-title" class="m-0 text-[clamp(52px,10.4vw,160px)] leading-[0.9] font-semibold tracking-[-0.055em] text-balance">
        <span class="block">CSS is evolving.</span>
        <span class="block text-ink-2">We’re exploring what comes next.</span>
      </h1>
      <div class="mt-[clamp(48px,7vw,104px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,360px),1fr))] gap-x-[clamp(32px,6vw,96px)] gap-y-6">
        <div aria-hidden="true" class="flex flex-wrap items-start gap-2.5 pt-1.5 font-mono text-[13px] text-mute">
          <span>color</span><span>→</span><span>layout</span><span>→</span><span>logic</span><span>→</span><span class="text-rx-strong">behavior?</span>
        </div>
        <div class="flex flex-col gap-[18px] text-[clamp(18px,1.7vw,22px)] leading-[1.55] text-ink-body">
          <p class="m-0 text-pretty">CSS has grown far beyond describing colors and layouts. It can calculate, respond to context, and express increasingly complex relationships.</p>
          <p class="m-0 text-pretty">Reactive CSS explores what happens when state and interactions become part of that declarative language.</p>
        </div>
      </div>
    </section>

    <section id="evolution" aria-labelledby="evolution-title" class={section}>
      <div class={`${container} py-[clamp(56px,8vw,112px)]`}>
        <SectionKicker comment n="02" label="The evolution" />
        <h2 id="evolution-title" class={`${h2} flex flex-wrap gap-x-[0.28em]`}>
          <span>Calculate</span><span aria-hidden="true" class="text-faint">→</span><span>Relate</span><span aria-hidden="true" class="text-faint">→</span><span>Decide</span><span aria-hidden="true" class="text-faint">→</span><span class="text-rx-strong">React?</span>
        </h2>
        <div class="mt-[clamp(24px,3vw,36px)] mb-[clamp(36px,4vw,56px)] flex flex-wrap items-baseline justify-between gap-x-10 gap-y-3">
          <p class="m-0 max-w-[56ch] text-[17px] leading-[1.6] text-pretty text-ink-2">Each step moved a little more logic out of scripts and into style. The order is conceptual, not a release history. Try each one.</p>
          <div class="flex flex-wrap gap-x-5 gap-y-2 font-mono text-xs text-ink-2">
            <span class="flex items-center gap-2"><span aria-hidden="true" class="w-[18px] border-t-[1.5px] border-ink" />native CSS</span>
            <span class="flex items-center gap-2"><span aria-hidden="true" class="w-[18px] border-t-[1.5px] border-dashed border-rx" />Reactive CSS · library, not a standard</span>
          </div>
        </div>
        <EvolutionSteps client:visible />
        <p class="mt-[clamp(32px,4vw,48px)] mb-0 max-w-[78ch] text-sm leading-[1.6] text-pretty text-ink-2">The first three are part of CSS. The fourth is not. It is syntax from an independent library, read by a small JavaScript runtime, and it is not part of any specification or browser roadmap.</p>
      </div>
    </section>

    <section id="native" aria-labelledby="native-title" class={section}>
      <div class={`${container} py-[clamp(56px,8vw,112px)]`}>
        <SectionKicker comment n="03" label="Native first" />
        <h2 id="native-title" class={`${h2} max-w-[18ch]`}>If the browser already does it well, use the browser.</h2>
        <ol class="mt-[clamp(48px,6vw,88px)] mb-0 flex list-none flex-col border-t border-ink p-0">
          {PRINCIPLES.map(([title, text], i) => (
            <li class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,300px),1fr))] gap-x-[clamp(24px,5vw,80px)] gap-y-2 border-b border-line py-[clamp(20px,2.4vw,32px)] transition-colors hover:bg-paper-band">
              <span class="flex items-baseline gap-4"><span class:list={['font-mono text-[13px]', i === 2 ? 'text-rx-strong' : 'text-mute']}>{i + 1}</span><span class="text-[clamp(26px,3vw,40px)] leading-[1.05] font-semibold tracking-[-0.03em]">{title}</span></span>
              <span class="pt-1 text-[17px] leading-[1.6] text-pretty text-ink-body">{text}</span>
            </li>
          ))}
        </ol>
        <aside aria-label="A small engineering story" class="mt-[clamp(48px,6vw,88px)] grid grid-cols-[repeat(auto-fit,minmax(min(100%,320px),1fr))] items-start gap-x-[clamp(32px,6vw,96px)] gap-y-5">
          <div class="flex flex-col gap-3.5">
            <span class="font-mono text-xs text-mute">An example</span>
            <p class="m-0 text-[clamp(22px,2.2vw,28px)] leading-[1.2] font-semibold tracking-[-0.02em] text-balance">We removed a feature because native CSS did it better.</p>
          </div>
          <div class="flex flex-col gap-3.5">
            <p class="m-0 text-base leading-[1.65] text-pretty text-ink-body">An experimental <del class="font-mono text-[0.92em] decoration-rx">wave()</del> helper animated a value back and forth. Native CSS animations already did the same thing, run by the browser and more efficiently, so the helper was removed in 0.5.0. <a href="/docs/geometry/#wave-was-removed">What replaced it →</a></p>
            <p class="m-0 text-base leading-normal font-semibold text-pretty">When the platform covers a case, library code should go.</p>
          </div>
        </aside>
      </div>
    </section>

    <section id="experiment" aria-labelledby="experiment-title" class={section}>
      <div class={`${container} py-[clamp(56px,8vw,112px)]`}>
        <SectionKicker comment n="04" label="The experiment" />
        <h2 id="experiment-title" class={`${h2} max-w-[20ch]`}>The interaction doesn’t disappear. <span class="text-ink-2">The imperative glue does.</span></h2>
        <div class="mt-[clamp(40px,5vw,72px)]"><ExperimentDemo client:visible /></div>
      </div>
    </section>

    <section id="direction" aria-labelledby="direction-title" class={section}>
      <div class={`${container} pt-[clamp(56px,8vw,112px)] pb-[clamp(64px,9vw,128px)]`}>
        <SectionKicker comment n="05" label="The direction" />
        <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,380px),1fr))] items-end gap-x-[clamp(32px,6vw,96px)] gap-y-7">
          <h2 id="direction-title" class={h2}>An experiment, not a standard.</h2>
          <p class="m-0 text-[17px] leading-[1.6] text-pretty text-ink-body">Reactive CSS is a practical way to test declarative interactions in today’s browsers. It does not predict what CSS will become, and it is not a proposal. Its value is in the questions it lets us answer with working code.</p>
        </div>
        <ol class="mt-[clamp(44px,5vw,72px)] mb-0 grid list-none grid-cols-[repeat(auto-fit,minmax(min(100%,280px),1fr))] gap-x-6 border-t border-ink p-0">
          {QUESTIONS.map((q, i) => (
            <li class="flex flex-col gap-2.5 border-b border-line pt-5 pb-6"><span aria-hidden="true" class:list={['font-mono text-xs', i === 3 ? 'text-rx-strong' : 'text-mute']}>?</span><span class="text-[clamp(19px,1.7vw,22px)] leading-[1.3] font-medium tracking-[-0.01em] text-pretty">{q}</span></li>
          ))}
        </ol>
        <div class="mt-[clamp(64px,8vw,120px)] flex flex-col gap-[clamp(24px,3vw,36px)]">
          <p class="m-0 text-[clamp(44px,8vw,124px)] leading-[0.9] font-semibold tracking-[-0.055em]">Explore the experiment.</p>
          <div class="flex flex-wrap gap-2.5">
            <a href="/examples/" class={buttonClass('primary', 'lg')}>Explore Examples</a>
            <a href="/docs/getting-started/" class={buttonClass('secondary', 'lg')}>Read the Documentation</a>
            {DISTRIBUTION.repository.public
              ? <a href={repositoryUrl()} class={buttonClass('secondary', 'lg')}>View source on GitHub</a>
              : <span aria-disabled="true" title="The repository is not public yet" class="inline-flex h-[46px] items-center gap-2.5 rounded-block border border-dashed border-line-dashed px-5 text-base font-medium text-mute">View source on GitHub<span class="font-mono text-[11px]">when available</span></span>}
          </div>
          <p class="m-0 text-sm leading-[1.6] text-pretty text-ink-2">A comparison with plain JavaScript is on the <a href="/examples/score-history/#vanilla">score history example</a>, and every live demo is in <a href="/examples/">Examples</a>. Test results and the limits of those measurements are in the <a href="/docs/performance/">performance report</a>.</p>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter groups={FOOTER_GROUPS} installTag={INSTALL_TAG} version={LIBRARY_VERSION} />
  <SearchDialog client:idle suggested={SUGGESTED} />
</BaseLayout>
