---
// The Examples gallery (design: design-source/Examples.dc.html). One catalog
// (src/lib/content/catalog.ts); API examples run live in their cards, one runtime per card on
// screen. Category tabs filter with a small script; without it every group is shown.
import AppShell from '~/layouts/AppShell.astro';
import { CardPreview } from '~/components/gallery/CardPreview';
import { GalleryCard } from '~/components/gallery/GalleryCard';
import { Tag } from '~/components/ui/Tag';
import { SiteFooter } from '~/components/navigation/SiteFooter';
import { INSTALL_TAG } from '~/lib/content/home';
import { LIBRARY_VERSION } from '~/lib/content/reference';
import { FOOTER_GROUPS } from '~/lib/content/site';
import { CATALOG, CATEGORIES, docsHref, gallerySpans, inCategory } from '~/lib/content/catalog';

const apis = (labels: string[]) => labels.map((label) => ({ label, reactive: !!docsHref(label) }));
const PREVIEW_ALL = 3; // cards per non-API group in the "All" view
---
<AppShell title="Examples" description="Small live examples of every Reactive CSS capability, complete interfaces from the library, the Control Center workspace and the library's browser test cases." context="examples" current="examples">
  <main data-pagefind-body data-pagefind-meta="section:Examples" data-gallery data-view="all" class="pb-[clamp(56px,7vw,96px)]">
    <section class="mx-auto max-w-(--container-marketing) px-(--gutter) pt-[clamp(40px,6vw,88px)] pb-[clamp(28px,3vw,44px)]">
      <div class="mb-5 font-mono text-meta text-mute">/* Examples */</div>
      <div class="flex flex-wrap items-end justify-between gap-x-16 gap-y-6">
        <h1 data-pagefind-meta="title" class="m-0 text-[clamp(48px,8vw,112px)] leading-[0.92] font-semibold tracking-display">CSS in action.</h1>
        <div class="flex flex-[0_1_440px] flex-col gap-4">
          <p class="m-0 text-[18px] leading-[1.55] text-pretty text-ink-body">One example, one capability, one visible result. Every preview runs the real runtime; open an example for its full source and notes.</p>
          <div class="flex flex-wrap gap-x-[18px] gap-y-2 font-mono text-label text-ink-2">
            <span class="flex items-center gap-2"><Tag tone="reactive">state()</Tag>needs the runtime</span>
            <span class="flex items-center gap-2"><Tag>calc()</Tag>native CSS</span>
          </div>
        </div>
      </div>
    </section>

    <div class="sticky top-[calc(var(--height-header)+var(--height-banner))] z-10 border-y border-line bg-[oklch(0.985_0.004_85/0.96)] backdrop-blur-[6px]">
      <div role="tablist" aria-label="Categories" class="mx-auto flex max-w-(--container-marketing) gap-1 overflow-x-auto px-(--gutter) [scrollbar-width:none]">
        {[{ id: 'all', name: 'All', n: CATALOG.length }, ...CATEGORIES.map((c) => ({ id: c.id, name: c.name, n: inCategory(c.id).length }))].map((t, i) => (
          <button type="button" role="tab" id={`tab-${t.id}`} aria-selected={i === 0 ? 'true' : 'false'} aria-controls="gallery-groups" data-tab={t.id} class="gallery-tab flex h-12 flex-none items-center gap-2 border-0 border-b-2 border-transparent bg-transparent px-3 text-[14.5px] text-ink-2 aria-selected:border-ink aria-selected:font-semibold aria-selected:text-ink">
            <span>{t.name}</span><span class="font-mono text-[11px] text-mute">{t.n}</span>
          </button>
        ))}
      </div>
    </div>

    <div id="gallery-groups" role="tabpanel" aria-labelledby="tab-all" class="mx-auto max-w-(--container-marketing) px-(--gutter)">
      {CATEGORIES.map((c) => {
        const list = inCategory(c.id);
        const spans = gallerySpans(list.length);
        return (
          <section id={c.id} data-group={c.id} aria-labelledby={`${c.id}-title`} class="scroll-mt-[160px] pt-[clamp(36px,4vw,56px)]">
            <div class="mb-4 flex flex-wrap items-baseline justify-between gap-x-6 gap-y-2">
              <div class="flex flex-wrap items-baseline gap-x-4 gap-y-1.5">
                <h2 id={`${c.id}-title`} class="m-0 text-[26px] font-semibold tracking-[-0.025em]">{c.name}</h2>
                <span class="text-[15px] text-ink-2">{c.blurb}</span>
              </div>
              {/* As in the design: "View all N →" when "All" shows part of the group, else "View <group> →". */}
              <button type="button" data-show={c.id} class="gallery-more border-0 bg-transparent p-0 py-1.5 text-sm font-medium underline decoration-underline underline-offset-4">{c.id !== 'api' && list.length > PREVIEW_ALL ? `View all ${list.length}` : `View ${c.id === 'api' ? c.name : c.name.toLowerCase()}`} →</button>
            </div>
            <p data-group-text class="m-0 mb-5 hidden max-w-[62ch] text-base leading-[1.6] text-pretty text-ink-2">{c.text}</p>
            <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 min-[68.75rem]:grid-cols-4">
              {list.map((e, i) => (
                <div data-card-index={i} class:list={[spans[i] === 2 && 'min-[68.75rem]:col-span-2', c.id !== 'api' && i >= PREVIEW_ALL && 'gallery-extra']}>
                  <GalleryCard wide={spans[i] === 2}
                    title={e.title} href={e.href} description={e.description} apis={apis(e.primary)} experimental={e.experimental} legacy={e.legacy} tech={e.card ? undefined : e.tech}
                                      >
                    {e.card && <CardPreview slot="preview" client:visible title={e.title} css={e.card.css} base={e.card.base} html={e.card.html} />}
                  </GalleryCard>
                </div>
              ))}
            </div>
          </section>
        );
      })}
    </div>
  </main>
  <SiteFooter groups={FOOTER_GROUPS} installTag={INSTALL_TAG} version={LIBRARY_VERSION} />
  <script>
    // Category tabs: "All" shows every group (three cards each except the API examples); a
    // category shows its group in full with its introduction. The URL hash keeps the choice.
    const root = document.querySelector<HTMLElement>('[data-gallery]')!;
    const tabs = [...root.querySelectorAll<HTMLButtonElement>('.gallery-tab')];
    const panel = document.getElementById('gallery-groups')!;
    const show = (id: string, focus = false) => {
      const tab = tabs.find((t) => t.dataset.tab === id) ?? tabs[0]!;
      for (const t of tabs) { t.setAttribute('aria-selected', String(t === tab)); t.tabIndex = t === tab ? 0 : -1; }
      root.dataset.view = tab.dataset.tab;
      root.querySelectorAll<HTMLElement>('[data-group]').forEach((g) => g.toggleAttribute('data-group-on', g.dataset.group === tab.dataset.tab));
      panel.setAttribute('aria-labelledby', tab.id);
      if (focus) tab.focus();
      if (location.hash.slice(1) !== tab.dataset.tab) history.replaceState(null, '', tab.dataset.tab === 'all' ? location.pathname : `#${tab.dataset.tab}`);
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(t.dataset.tab!));
      t.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) { e.preventDefault(); show(tabs[(i + d + tabs.length) % tabs.length]!.dataset.tab!, true); }
      });
    });
    root.querySelectorAll<HTMLButtonElement>('.gallery-more').forEach((b) => b.addEventListener('click', () => { show(b.dataset.show!); scrollTo({ top: 0 }); }));
    show(location.hash.slice(1) || 'all');
    addEventListener('hashchange', () => show(location.hash.slice(1) || 'all'));
  </script>
</AppShell>
