---
// Experiments (design: Experiments.dc.html): curated demos that use Reactive CSS for light, depth
// and motion. Entries come from src/lib/content/experiments.ts; each runs live in its preview.
// The design's "Coming next" drafts are not shown: only finished experiments are listed.
import BaseLayout from '~/layouts/BaseLayout.astro';
import { SearchDialog } from '~/components/navigation/SearchDialog';
import { SiteFooter } from '~/components/navigation/SiteFooter';
import { SiteHeader, SiteMenu } from '~/components/navigation/SiteHeader';
import ExperimentFrame from '~/components/experiments/ExperimentFrame.astro';
import Orbits from '~/components/experiments/Orbits.astro';
import SourceLink from '~/components/experiments/SourceLink.astro';
import { EXPERIMENTS, experimentHref } from '~/lib/content/experiments';
import { FOOTER_GROUPS, HOME_LINKS, SUGGESTED } from '~/lib/content/site';
import { INSTALL_TAG } from '~/lib/content/home';
import { LIBRARY_VERSION } from '~/lib/content/reference';

const links = HOME_LINKS.map((l) => ({ ...l, current: l.href === '/experiments/' }));
const container = 'mx-auto max-w-(--container-marketing) px-(--gutter)';
const tag = 'rounded-tag border border-line bg-paper-band px-2 py-1 font-mono text-label text-ink-body';
const published = EXPERIMENTS.filter((x) => x.status === 'published').length;
---
<BaseLayout title="Experiments" description="Curated Reactive CSS demos for light, depth and motion. Each one is a stylesheet and the runtime: play with it, then open its source.">
  <SiteHeader variant="home" links={links} menuTarget="site-menu" />
  <SiteMenu id="site-menu" links={links} />
  <main data-pagefind-body data-pagefind-meta="section:Experiments">
    <section aria-labelledby="experiments-title">
      <div class={`${container} flex flex-col gap-[clamp(24px,3vw,36px)] pt-[clamp(40px,6vw,88px)] pb-[clamp(40px,5vw,64px)]`}>
        <div class="flex flex-wrap justify-between gap-x-6 gap-y-2 font-mono text-meta text-mute"><span>/* experiments */</span><span>curated from our lab</span></div>
        <h1 id="experiments-title" class="m-0 text-[clamp(64px,12.5vw,188px)] leading-[0.84] font-semibold tracking-[-0.06em]">Experi&shy;ments<span class="text-rx">.</span></h1>
        <div class="flex flex-wrap items-end justify-between gap-x-16 gap-y-5">
          <p class="m-0 max-w-[52ch] text-[18px] leading-[1.6] text-pretty text-ink-2">Demos that use Reactive CSS for light, depth and motion. Each one is a stylesheet and the runtime. Play with it, then open the source.</p>
          <div class="flex gap-7 font-mono text-meta text-ink-2"><span><span class="text-ink">{String(published).padStart(2, '0')}</span> published</span></div>
        </div>
      </div>
    </section>

    {EXPERIMENTS.map((x, i) => (
      <section aria-labelledby={`xp-${x.slug}`} class="border-t border-line" data-experiment-entry={x.slug}>
        <article class={`${container} flex flex-wrap items-stretch gap-[clamp(32px,4vw,64px)] pt-[clamp(32px,4vw,56px)] pb-[clamp(56px,7vw,96px)]`}>
          <div class="relative flex min-h-[clamp(480px,56vw,680px)] min-w-0 flex-[1.5_1_520px] items-center justify-center overflow-hidden rounded-block bg-[oklch(0.16_0.01_70)]">
            <Orbits rings={[{ size: 480, alpha: 0.08 }, { size: 720, dashed: true, alpha: 0.07 }]} body={360} />
            <div class="pointer-events-none absolute top-4 right-[18px] left-[18px] z-[1] flex justify-between font-mono text-tag text-[oklch(0.7_0.006_80)]"><span>{x.no} / live</span><span>move · click</span></div>
            <ExperimentFrame experiment={x} mode="card" title={`${x.title}, live preview`} lazy={i > 0} class="relative h-[clamp(440px,46vw,580px)] w-full" />
          </div>
          <div class="flex min-w-0 flex-[1_1_320px] flex-col justify-between gap-9 pt-2">
            <div class="flex flex-col gap-[18px]">
              <div class="flex items-center gap-2.5 font-mono text-label text-mute">
                <span class="font-semibold text-rx">{x.no}</span><span>{i === 0 ? 'featured' : 'experiment'}</span><span class="h-px flex-1 bg-line"></span>
                <span class="rounded-tag border border-ink px-[7px] py-0.5 text-ink">{x.status}</span>
              </div>
              <h2 id={`xp-${x.slug}`} class="m-0 text-[clamp(36px,4.4vw,56px)] leading-[0.98] font-semibold tracking-[-0.045em] text-balance">{x.title}</h2>
              <p class="m-0 text-body leading-[1.6] text-pretty text-ink-2">{x.description}</p>
              <ul class="m-0 flex list-none flex-wrap gap-1.5 p-0" aria-label="Capabilities">{x.tags.map((t) => <li class={tag}>{t}</li>)}</ul>
            </div>
            <div class="flex flex-col gap-6">
              <dl class="m-0 grid grid-cols-[auto_1fr] gap-x-5 gap-y-2.5 border-t border-line pt-[18px] text-[14px]">
                <dt class="pt-0.5 font-mono text-label text-mute">Browsers</dt><dd class="m-0 text-ink-body">{x.browsers.tested.join(', ')} tested · {x.browsers.notVerified.join(', ')} not verified</dd>
                <dt class="pt-0.5 font-mono text-label text-mute">Input</dt><dd class="m-0 text-ink-body">{x.input.short}</dd>
                <dt class="pt-0.5 font-mono text-label text-mute">Motion</dt><dd class="m-0 text-ink-body">{x.motion.short}</dd>
              </dl>
              <div class="flex flex-wrap gap-2.5">
                <a href={experimentHref(x)} class="inline-flex h-[46px] items-center rounded-block bg-ink px-5 text-base font-medium text-on-ink no-underline hover:bg-ink-hover">Open demo</a>
                <SourceLink experiment={x} class="inline-flex h-[46px] items-center gap-2 rounded-block border border-ink px-[18px] text-base font-medium no-underline transition-colors hover:bg-ink hover:text-on-ink" arrowClass="font-mono text-[13px]" />
              </div>
            </div>
          </div>
        </article>
      </section>
    ))}

    <section class="border-t border-line" aria-label="Next steps">
      <div class={`${container} flex flex-wrap items-center justify-between gap-x-12 gap-y-4 py-[clamp(40px,5vw,64px)]`}>
        <p class="m-0 max-w-[56ch] text-body leading-[1.55] text-pretty text-ink-body">Every experiment links to its folder in the repository. Fork one, or start from a blank rule in the Playground.</p>
        <div class="flex flex-wrap gap-x-7 gap-y-3 text-base font-medium">
          <a href="/playground/">Open Playground →</a>
          <a href="/examples/" class="font-normal text-ink-2">Browse Examples</a>
        </div>
      </div>
    </section>
  </main>
  <SiteFooter groups={FOOTER_GROUPS} installTag={INSTALL_TAG} version={LIBRARY_VERSION} />
  <SearchDialog client:idle suggested={SUGGESTED} />
</BaseLayout>
