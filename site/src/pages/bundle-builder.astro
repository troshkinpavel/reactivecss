---
// The custom bundle configurator (catalog of the synced library version). A static page with one island; the catalog,
// resolver semantics, measured sizes and package metadata come from the library at build time
// (src/lib/bundles/). It generates commands for the library's own CLI; it builds nothing itself.
import BaseLayout from '~/layouts/BaseLayout.astro';
import Redirect from '~/layouts/Redirect.astro';
import { BundleBuilder, type FeatureRefs } from '~/components/builder/BundleBuilder';
import { SearchDialog } from '~/components/navigation/SearchDialog';
import { SiteFooter } from '~/components/navigation/SiteFooter';
import { SiteHeader } from '~/components/navigation/SiteHeader';
import { API, LIBRARY_VERSION, apiHref } from '~/lib/content/reference';
import { INSTALL_TAG } from '~/lib/content/home';
import { API_FEATURE, COMPACT, PACKAGE, SIZES, STANDARD } from '~/lib/bundles/catalog';
import { FOOTER_GROUPS, SUGGESTED } from '~/lib/content/site';
import { FEATURES } from '~/lib/config';
import { APPROVED_FEATURES } from '~/lib/config/schema';

// Hidden in config/features.json: the route stays, as a redirect, so existing links never break.
const hidden = !FEATURES.bundleBuilder;

const refs: FeatureRefs = {};
for (const e of API) {
  if (e.removal) continue;
  for (const f of new Set(e.features.map((k) => API_FEATURE[k]).filter((x): x is string => !!x))) (refs[f] ??= []).push({ name: e.name, href: apiHref(e.id) });
}
const nf = new Intl.NumberFormat('en-US');
const container = 'mx-auto max-w-(--container-marketing) px-(--gutter)';
const docs = [
  { label: 'Custom bundles', href: '/docs/custom-bundles/', note: 'CLI, API, dependencies, the analyzer and its limits' },
  { label: 'Installation', href: '/docs/installation/', note: 'npm, CDN after publication, choosing a distribution' },
  { label: 'API reference', href: '/docs/reference/', note: 'every function, selector and declaration' },
  { label: 'Getting started', href: '/docs/getting-started/', note: 'the full runtime, first' },
  { label: 'Performance', href: '/docs/performance/', note: 'how the library measures itself' },
  { label: 'Examples', href: '/examples/', note: 'the demos the summary links to' },
];
---
{hidden ? <Redirect to={APPROVED_FEATURES.bundleBuilder.fallback} title="Bundle Builder" /> : (
<BaseLayout title="Bundle Builder" description="Choose the Reactive CSS features your project uses. The builder resolves their dependencies and generates the command for an optimized bundle.">
  <SiteHeader context="bundle builder" links={[{ label: 'Docs', href: '/docs/getting-started/' }, { label: 'API', href: '/docs/reference/' }, { label: 'Playground', href: '/playground/' }]} />
  <main data-pagefind-body data-pagefind-meta="title:Bundle Builder, section:Bundle Builder">
    <section aria-labelledby="builder-title" class={`${container} pt-[clamp(32px,5vw,64px)] pb-8`}>
      <div class="mb-5 flex flex-wrap gap-3 font-mono text-meta text-mute"><span>/* Custom bundles · {PACKAGE.name} {PACKAGE.version} */</span>{!PACKAGE.published && <span class="rounded-tag border border-dashed border-line-dashed px-1.5 text-ink-2">not published yet</span>}</div>
      <div class="flex flex-wrap items-end justify-between gap-x-16 gap-y-6">
        <h1 id="builder-title" class="m-0 max-w-[14ch] flex-[1_1_420px] text-[clamp(36px,5.4vw,72px)] leading-[0.95] font-semibold tracking-h1 text-balance">Build only what you need.</h1>
        <p class="m-0 max-w-[480px] flex-[1_1_320px] text-body leading-[1.6] text-pretty text-ink-2">Choose the Reactive CSS capabilities your project uses. We’ll resolve the dependencies and generate the configuration for an optimized bundle.</p>
      </div>
    </section>
    <div class={`${container} pb-[clamp(48px,6vw,80px)]`}>
      <BundleBuilder client:load refs={refs} />
    </div>
    <section aria-labelledby="dist-title" class="border-t border-line bg-paper-band">
      <div class={`${container} grid gap-10 py-[clamp(48px,6vw,80px)] lg:grid-cols-[minmax(0,1fr)_minmax(0,1fr)]`}>
        <div class="flex min-w-0 flex-col gap-4">
          <h2 id="dist-title" class="m-0 text-h2 font-semibold tracking-h2">Or don’t build anything</h2>
          <p class="m-0 text-note leading-[1.6] text-ink-2">The standard bundle has every feature and needs no tooling: start with it, and build a custom one when size matters. The compact bundle is the same full runtime with a shorter feature registry in <code class="font-mono text-[0.9em]">describe()</code>; it is not a feature selection.</p>
          <table class="w-full border-collapse text-left text-[14px]">
            <caption class="pb-2 text-left font-mono text-tag text-mute">Measured for {SIZES.version}, in bytes</caption>
            <thead><tr class="border-b border-ink font-mono text-tag text-mute"><th class="py-2 font-normal">Bundle</th><th class="py-2 pl-3 text-right font-normal">min</th><th class="py-2 pl-3 text-right font-normal">gzip</th><th class="py-2 pl-3 text-right font-normal">brotli</th></tr></thead>
            <tbody>
              {[['reactive-css.min.js', 'standard: every feature', STANDARD], ['reactive-css.compact.min.js', 'every feature, compact describe()', COMPACT]].map(([file, note, m]) => (
                <tr class="border-b border-line">
                  <th scope="row" class="py-2.5 pr-3 font-normal"><span class="font-mono text-[13px] [overflow-wrap:anywhere]">{file as string}</span><br /><span class="text-[13px] text-ink-2">{note as string}</span></th>
                  <td class="py-2.5 pl-3 text-right font-mono text-[13px]">{nf.format((m as typeof STANDARD).minified)}</td>
                  <td class="py-2.5 pl-3 text-right font-mono text-[13px]">{nf.format((m as typeof STANDARD).gzip)}</td>
                  <td class="py-2.5 pl-3 text-right font-mono text-[13px]">{nf.format((m as typeof STANDARD).brotli)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
        <nav aria-labelledby="docs-title" class="flex min-w-0 flex-col gap-3">
          <h2 id="docs-title" class="m-0 text-h2 font-semibold tracking-h2">Read more</h2>
          <ul class="m-0 list-none p-0">
            {docs.map((d) => <li class="border-b border-line py-2.5"><a href={d.href} class="font-medium">{d.label}</a> <span class="text-[14px] text-ink-2">· {d.note}</span></li>)}
          </ul>
        </nav>
      </div>
    </section>
  </main>
  <SiteFooter groups={FOOTER_GROUPS} installTag={INSTALL_TAG} version={LIBRARY_VERSION} />
  <SearchDialog client:idle suggested={SUGGESTED} />
</BaseLayout>
)}
