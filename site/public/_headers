# Cloudflare Workers Static Assets headers (copied to dist/ by the build).
# No Cross-Origin-Resource-Policy or COEP: the sandboxed preview frames (opaque origin) load /runtime/*.js.
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Strict-Transport-Security: max-age=31536000

# Content-hashed bundles never change.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
